# Copy this file to .env and replace the placeholders.
# Never commit .env or real credentials.

# MySQL connection
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# The Flask API reads these values at startup.
SESSION_SECRET=replace-with-a-long-random-value
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=
INTERVIEWIQ_ADMIN_EMAIL=owner@example.com
INTERVIEWIQ_ADMIN_PASSWORD=

# Local development defaults
PORT=8080
BASE_PATH=/
